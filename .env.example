# PostgreSQL connection used by Prisma.
# For local execution with the database configured in docker-compose.yml:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app_db?schema=public"

# Optional. Used only when the local ticket classification is inconclusive.
# If omitted, the application saves the local inconclusive classification.
GEMINI_API_KEY="your-gemini-api-key"
